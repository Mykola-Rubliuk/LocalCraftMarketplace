@startuml
 title Integrated Design Class Diagram — Local Craft Marketplace (Slices 1, 3 and 4)
 left to right direction
 skinparam packageStyle rectangle
 skinparam classAttributeIconSize 0
 skinparam shadowing false
 skinparam linetype ortho
 skinparam nodesep 35
 skinparam ranksep 45
 hide empty members

' ============================================================
' SHARED CONTRACTS — the only cross-slice integration points
' ============================================================
 package "Shared Contracts" as Shared {
   interface StockAvailabilityPort <<shared port>> {
     +getStatus(itemCode: String): StockStatus
     +reserveIfAvailable(itemCode: String): StockOperationResult
     +sellAllIfAvailable(stockLines: List<StockLine>, idempotencyKey: String): StockOperationResult
     +releaseIfReserved(itemCode: String): StockOperationResult
   }

   interface SaleRecordingPort <<provided by Slice 4>> {
     +recordSale(request: SaleRequest): SaleRecordingResult
     +findRecordedResult(request: SaleRequest): SaleRecordingResult?
   }

   interface Clock <<shared port>> {
     +now(): DateTime
   }

   enum StockStatus {
     Available
     Reserved
     Sold
     Unknown
   }

   class StockLine <<value object>> {
     +itemCode: String
     +quantity: Integer
   }

   abstract class StockOperationResult <<result shape>>
   class StockUpdated {
     +status: StockStatus
   }
   class StockRejected {
     +reason: String
     +itemCode: String?
   }

   class SaleRequest <<request DTO>> {
     +idempotencyKey: String
     +processedBy: String
     +channel: SaleChannel
     +customerRef: String?
     +saleDate: Date?
     +sourceRef: String?
   }

   class SaleRequestLine <<request DTO>> {
     +itemCode: String
     +quantity: Integer
     +soldPrice: Money
     +discountAmount: Money?
   }

   enum SaleChannel {
     InStore
     OfflineMarket
   }

   class ValidationResult <<validation result>> {
     +valid: Boolean
     +reason: String?
   }

   abstract class SaleRecordingResult <<business result>>
   class Recorded {
     +saleRef: String
   }
   class Rejected {
     +reason: String
   }
 }

' ============================================================
' SLICE 1 — RESERVATION
' ============================================================
 package "Slice 1 — Manage Reservation (UC-02)" as S1 {
   class ReservationService <<controller>> {
     +recordReservation(itemCode: String, customerRef: String, conditions: ReservationConditions): ReservationResult
     +evaluateExpiry(asOf: DateTime): List<Reservation>
     -validateRequest(itemCode: String, customerRef: String, conditions: ReservationConditions): ValidationResult
     -keepActive(): void
   }

   class Reservation <<entity>> {
     +reservationId: String
     +itemCode: String
     +customerRef: String
     +conditions: ReservationConditions
     +status: ReservationStatus
     +agreedExpiry: DateTime
     +create(itemCode: String, customerRef: String, conditions: ReservationConditions, agreedExpiry: DateTime): Reservation
     +getAgreedExpiry(): DateTime
     +expire(): void
   }

   class ReservationRepository <<repository>> {
     +findActiveByItemCode(itemCode: String): Reservation?
     +findAllActive(): List<Reservation>
     +save(reservation: Reservation): String
     +update(reservation: Reservation): void
   }

   class ReservationPolicy <<domain policy>> {
     +calculateExpiry(currentDateTime: DateTime): DateTime
   }

   class ReservationConditions <<value object>>

   enum ReservationStatus {
     Active
     Expired
   }

   abstract class ReservationResult <<result abstraction>>
   class ReservationConfirmed {
     +reservationId: String
     +agreedExpiry: DateTime
   }
   class ReservationRejected {
     +reason: String
   }
   class ReservationTechnicalFailure {
     +reason: String
   }
 }

' ============================================================
' SLICE 3 — OFFLINE RECONCILIATION
' ============================================================
 package "Slice 3 — Reconcile Offline Transactions (UC-10)" as S3 {
   class OfflineReconciliationService <<controller>> {
     +enterOfflineTransaction(submissionId: String, offlineRef: String, saleDate: Date, recordedBy: String, lines: List<OfflineLine>): OfflineOperationResult
     +reconcile(entryId: String): OfflineOperationResult
     +resolve(entryId: String, decision: ResolutionDecision, note: String): OfflineOperationResult
     -requireCoordinatorRole(): void
     -requireManagerRole(): void
   }

   class OfflineTransaction <<entity>> {
     +entryId: String
     +submissionId: String
     +offlineRef: String
     +saleDate: Date
     +recordedBy: String
     +recordedAt: DateTime
     +status: OfflineTransactionStatus
     +referralReason: ReferralReason?
     +referralDetail: String?
     +saleRef: String?
     +saleRequest: SaleRequest?
     +decision: ResolutionDecision?
     +resolutionNote: String?
     +resolvedBy: String?
     +resolvedAt: DateTime?
     +create(submissionId: String, offlineRef: String, saleDate: Date, recordedBy: String, recordedAt: DateTime, lines: List<OfflineLine>): OfflineTransaction
     +markReconciled(saleRef: String): void
     +refer(reason: ReferralReason, detail: String?): void
     +resolve(decision: ResolutionDecision, note: String, resolvedBy: String, resolvedAt: DateTime): void
   }

   class OfflineLine <<entity>> {
     +itemCode: String
     +quantity: Integer
     +soldPrice: Money
   }

   class ConflictChecker <<domain service>> {
     +check(transaction: OfflineTransaction): ReferralReason?
   }

   class OfflineTransactionRepository <<repository>> {
     +findByEntryId(entryId: String): OfflineTransaction?
     +findBySubmissionId(submissionId: String): OfflineTransaction?
     +existsOtherWithRef(offlineRef: String, entryId: String): Boolean
     +save(transaction: OfflineTransaction): void
     +countByStatus(status: OfflineTransactionStatus): Integer
   }

   enum OfflineTransactionStatus {
     AwaitingReconciliation
     Reconciled
     ReferredToManager
     Resolved
   }

   enum ResolutionDecision {
     Accepted
     Adjusted
     Rejected
     FollowUpOutsideSystem
   }

   abstract class OfflineOperationResult <<business result>>
   class OfflineOperationSuccess
   class OfflineOperationRejected {
     +reason: String
     +invalidFields: List<String>
   }

   enum ReferralReason {
     DuplicateReference
     ItemAlreadySold
     ItemReserved
     ItemUnknown
     SaleRejected
   }

 }

' ============================================================
' SLICE 4 — CUSTOMER SALE
' ============================================================
 package "Slice 4 — Process Customer Sale (UC-01)" as S4 {
   class SaleService <<controller / port provider>> {
     +recordSale(request: SaleRequest): SaleRecordingResult
     +findRecordedResult(request: SaleRequest): SaleRecordingResult?
     -validateRequestAndIdempotency(request: SaleRequest): ValidationResult
   }

   class ProductCatalogue <<catalogue>> {
     +findItem(itemCode: String): CatalogueItemDetails?
   }

   class CatalogueItemDetails <<lookup result>> {
     +itemCode: String
   }

   class Product <<entity>> {
     +productId: String
     +description: String
     +basePrice: Money
   }

   class Maker <<entity>> {
     +makerId: String
     +name: String
   }

   class SaleRepository <<repository>> {
     +findByIdempotencyKey(key: String): IdempotencyRecord?
     +persist(sale: Sale, record: IdempotencyRecord): PersistenceResult
   }

   class IdempotencyRecord <<value object>> {
     +idempotencyKey: String
     +requestFingerprint: String
     +saleRef: String
   }

   class Sale <<entity / aggregate root>> {
     +saleRef: String
     +processedBy: String
     +customerRef: String?
     +sourceRef: String?
     +channel: SaleChannel
     +saleDate: Date
     +recordedAt: DateTime
     +status: SaleStatus
     +create(request: SaleRequest, recordedAt: DateTime): Sale
     +addLine(line: SaleLine): void
     +calculateTotal(): Money
   }

   class SaleLine <<entity>> {
     +itemCode: String
     +soldPrice: Money
     +quantity: Integer
     +discountAmount: Money?
     +create(item: CatalogueItemDetails, maker: Maker, soldPrice: Money, quantity: Integer, discountAmount: Money?): SaleLine
     +calculateNetAmount(): Money
   }

   enum SaleStatus {
     Completed
   }

   class PersistenceResult <<technical result>> {
     +successful: Boolean
     +reason: String?
   }
 }


 SaleService ..|> SaleRecordingPort : implements

 ReservationService ..> StockAvailabilityPort : uses
 ReservationService ..> Clock : uses
 ReservationService --> ReservationRepository : coordinates
 ReservationService --> ReservationPolicy : asks expiry
 ReservationService --> Reservation : creates / updates
 ReservationRepository --> Reservation : stores

 OfflineReconciliationService ..> SaleRecordingPort : records / recovers sale
 OfflineReconciliationService ..> Clock : timestamps records
 OfflineReconciliationService --> OfflineTransactionRepository : stores / retrieves
 OfflineReconciliationService --> ConflictChecker : asks for conflict check
 OfflineReconciliationService --> OfflineTransaction : creates / changes state
 ConflictChecker ..> StockAvailabilityPort : getStatus only
 ConflictChecker --> OfflineTransactionRepository : checks duplicate offlineRef
 OfflineTransaction "1" *-- "1..*" OfflineLine : contains

 SaleService ..> StockAvailabilityPort : validates and sells stock
 SaleService ..> StockLine : maps stock batch request
 SaleService ..> Clock : recordedAt / default saleDate
 SaleService --> ProductCatalogue : resolves item and maker
 SaleService --> SaleRepository : reads idempotency / persists
 SaleService --> Sale : creates
 SaleService ..> SaleLine : creates
 SaleService ..> IdempotencyRecord : compares request
 SaleRepository ..> IdempotencyRecord : stores / retrieves
 Sale "1" *-- "1..*" SaleLine : contains
 ProductCatalogue ..> CatalogueItemDetails : returns
 CatalogueItemDetails --> "1" Product : identifies
 CatalogueItemDetails --> "0..1" Maker : identifies
 SaleLine "0..*" --> "1" Product : product details
 SaleLine "0..*" --> "1" Maker : maker attribution

 SaleRequest "1" *-- "0..*" SaleRequestLine : lines
 ReservationResult <|-- ReservationConfirmed
 ReservationResult <|-- ReservationRejected
 ReservationResult <|-- ReservationTechnicalFailure
 SaleRecordingResult <|-- Recorded
 SaleRecordingResult <|-- Rejected
 StockOperationResult <|-- StockUpdated
 StockOperationResult <|-- StockRejected
 OfflineOperationResult <|-- OfflineOperationSuccess
 OfflineOperationResult <|-- OfflineOperationRejected
 OfflineOperationSuccess --> "1" OfflineTransaction : returns


' Contract constraints (not extra implementation classes).
note right of SaleRecordingPort
  Technical failures are reported separately
  from business result variants.
  findRecordedResult is read-only:
  same key/payload -> Recorded(saleRef);
  same key/different payload -> Rejected(IdempotencyKeyConflict);
  no committed result -> null.
  Lookup failure is a technical error, not null.
  Authorise the caller before returning a stored result.
end note

note right of OfflineReconciliationService
  Persist the stable SaleRequest before the first sale
  attempt and reuse it on retries. Authorise each caller.
  Recover any committed sale before stock/duplicate checks.
  Serialize processing for the same entryId.
  Technical failures leave the entry retryable;
  only Recorded permits Reconciled.
end note

note bottom of StockAvailabilityPort
  Stock service failures are technical errors,
  not stock statuses or business refusals.
end note

note bottom of SaleRepository
  Sale, SaleLines, idempotency record and stock
  changes commit together or roll back together.
  Same key is processed once; compare the payload
  before checking stock on a repeated sale request.
end note

note bottom of ReservationRepository
  Reservation and related stock changes are atomic.
  Expiry releases stock only if the owning reservation
  has expired and no other commitment applies.
end note

@enduml
