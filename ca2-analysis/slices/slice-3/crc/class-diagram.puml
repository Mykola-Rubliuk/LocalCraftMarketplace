@startuml
title Slice 3 — design classes
class OfflineReconciliationService {
  +enterOfflineTransaction(submissionId, offlineRef, date, items, prices) : EntryResult
  +reconcile(offlineRef) : ReconciliationStatus
  +resolve(offlineRef, decision, note) : ReconciliationStatus
}
class OfflineTransaction {
  -entryId
  -submissionId
  -offlineRef
  -saleDate
  -recordedBy
  -recordedAt
  -status : ReconciliationStatus
  -referralReason
  -saleId
  -decision : ManagerDecision
  -resolutionNote
  -resolvedBy
  -resolvedAt
  +markReconciled(saleId)
  +refer(reason)
  +resolve(decision, note, by, at)
}
class OfflineLine {
  -itemCode
  -price
}
class ConflictChecker {
  +check(tx) : Optional<ReferralReason>
}
interface OfflineTransactionRepository {
  +save(tx)
  +findByRefAndStatus(offlineRef, status)
  +findBySubmissionId(submissionId)
  +existsOtherWithRef(offlineRef, entryId)
  +countByStatus(status)
}
interface StockAvailabilityPort {
  +availabilityOf(itemCode)
}
interface SaleRecordingPort {
  +recordSale(request) : SaleResult
}
interface Clock
enum ReconciliationStatus {
  AwaitingReconciliation
  Reconciled
  ReferredToManager
  Resolved
}

OfflineTransaction "1" *-- "1..*" OfflineLine
OfflineReconciliationService --> OfflineTransactionRepository
OfflineReconciliationService --> ConflictChecker
OfflineReconciliationService --> SaleRecordingPort
OfflineReconciliationService --> Clock
ConflictChecker --> OfflineTransactionRepository
ConflictChecker --> StockAvailabilityPort
@enduml