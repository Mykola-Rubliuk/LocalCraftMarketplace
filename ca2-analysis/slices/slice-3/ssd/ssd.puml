@startuml
title SSD — UC-10 Reconcile Offline Transactions
actor "Market Coordinator" as C
actor Manager as M
participant ":System" as S

loop for each completed offline form
  C -> S : enterOfflineTransaction(submissionId, offlineRef, date, items, prices)
  S --> C : entryId, status (AwaitingReconciliation | ReferredToManager: DuplicateReference)
end
loop for each record awaiting reconciliation
  C -> S : reconcile(offlineRef)
  S --> C : Reconciled | ReferredToManager(reason)
end
loop for each referred record
  M -> S : resolve(offlineRef, decision, note)
  S --> M : Resolved
end
@enduml